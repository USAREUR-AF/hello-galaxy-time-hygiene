#!/usr/bin/env bash
# hello-time — run the scenarios.
#
#   bin/hello-time            all of them, in order
#   bin/hello-time 3          just scenario 3
#   bin/hello-time offline    the five that need no fabric
#   bin/hello-time test       verify the reference against the production vectors
set -uo pipefail
cd "$(dirname "$0")/.."

SCENARIOS=(
  "01-two-watches"
  "02-absence-is-not-health"
  "03-verify-an-attestation"
  "04-the-liar"
  "05-free-run-together"
  "06-cold-boot-1970"
)

run_one() {
  local dir="scenarios/$1"
  if [ -x "$dir/run.sh" ]; then "$dir/run.sh"
  elif [ -f "$dir/run.py" ]; then python3 "$dir/run.py"
  else echo "no runner in $dir" >&2; return 1; fi
}

case "${1:-all}" in
  test)    exec python3 tests/verify_vectors.py ;;
  offline) list=("${SCENARIOS[@]:1}") ;;
  all)     list=("${SCENARIOS[@]}") ;;
  [1-6])   list=("${SCENARIOS[$(( $1 - 1 ))]}") ;;
  *)       list=("$1") ;;
esac

rc=0
for s in "${list[@]}"; do
  run_one "$s" || rc=1
done
exit "$rc"
